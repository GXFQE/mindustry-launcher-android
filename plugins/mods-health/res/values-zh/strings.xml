<resources>
    <string name="cf_contained_title_fmt">「%1$s」里已经带了「%2$s」</string>
    <string name="cf_contained_detail">两个一起开会互相抢，建议只留一个。</string>
    <string name="cf_log_title_fmt">上次启动的日志里有 %1$d 行提到这些模组</string>

    <string name="cf_none">没发现明显冲突</string>
