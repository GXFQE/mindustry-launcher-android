{
  "entry": "io.mdt.plugins.mapstats.MapStatsPage",
  "name": "mapstats",
  "version": "6",
  "author": "mdt",
  "description": "map resource statistics (ores / walls / floors / buildable / core zone)",
  "update": "https://github.com/GXFQE/mindustry-launcher-android/releases/download/plugins-latest/mapstats.json",
  "access": [
    "slots"
  ],
  "extensions": [
    {
      "id": "mapstats-maps",
      "title": "导出统计…",
      "subtitle": "选一张或多张；详细 / 简洁，直接保存或分享",
      "entry": "io.mdt.plugins.mapstats.MapStatsPage",
      "slot": "action",
      "page": "maps"
    },
    {
      "id": "mapstats-section",
      "title": "资源统计",
      "subtitle": "统计这张地图的矿物 / 可采地板 / 可建造区域",
      "entry": "io.mdt.plugins.mapstats.MapStatsPage",
      "slot": "section",
      "page": "map-detail"
    },
    {
      "id": "mapstats-sort-reach",
      "title": "按可采资源（多的在前）",
      "entry": "io.mdt.plugins.mapstats.SortReach",
      "slot": "sort",
      "page": "maps"
    },
    {
      "id": "mapstats-sort-build",
      "title": "按能建格数（多的在前）",
      "entry": "io.mdt.plugins.mapstats.SortBuild",
      "slot": "sort",
      "page": "maps"
    },
    {
      "id": "mapstats-sort-cores",
      "title": "按可建核心数（多的在前）",
      "entry": "io.mdt.plugins.mapstats.SortCores",
      "slot": "sort",
      "page": "maps"
    },
    {
      "id": "mapstats-sort-ore",
      "title": "按某矿含量（多的在前）…",
      "entry": "io.mdt.plugins.mapstats.SortOre",
      "slot": "sort",
      "page": "maps"
    },
    {
      "id": "mapstats-filter-core",
      "title": "只看有核心区的图",
      "entry": "io.mdt.plugins.mapstats.FilterCore",
      "slot": "filter",
      "page": "maps"
    },
    {
      "id": "mapstats-filter-ore",
      "title": "只看含某矿的图…",
      "entry": "io.mdt.plugins.mapstats.FilterOre",
      "slot": "filter",
      "page": "maps"
    }
  ]
}
