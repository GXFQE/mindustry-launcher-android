<?xml version="1.0" encoding="utf-8"?>
<!--
  F6c：导入整槽 zip 的**确认框**（AlertDialog.setView 的载体）。

  为什么要先弹这一屏：解包是**写操作**，而且可能带"先清空"这种不可逆动作。
  用户必须先在**看见这个包里有什么**（文件数 / 大小 / 顶级目录 / 是不是游戏原生格式）
  之后才决定要不要动手 —— 这是 SlotZip 特意分成 inspect → extract 两趟的原因。
  同一屏里再给出「先清空」这个开关，省掉一次来回。

  ⚠️ 只用 setTitle，不用 setMessage（同 dialog_policy.xml 的注释）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- 包内容清单：文件数 · 大小 · 顶级条目 · 剥掉的包裹目录 -->
        <TextView
            android:id="@+id/zip_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/fg"
            android:textSize="13sp"
            android:lineSpacingExtra="4dp" />

        <!-- 非原生格式 / 不认识的包 —— 只提示，不拒绝（用户手打的包也该能导） -->
        <TextView
            android:id="@+id/zip_warn"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/pol_live_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/fg"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:background="@color/divider" />

        <!--
          写入模式（更新 / 反向更新 / 覆盖）。★ 2026-10-05 第 104 轮把原来的「先清空」复选框
          换成了这一组单选：用户要的是**三个模式**，而不是"要不要清空"这一个开关 ——
          "两边的同名文件谁说了算"同样重要（反向更新就是为此存在的）。
          判据与实现都在 SlotWrite，两处共用（另一处是快照恢复）。
        -->
        <include
            android:id="@+id/zip_mode"
            layout="@layout/dialog_slot_mode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>
</ScrollView>
