<?xml version="1.0" encoding="utf-8"?>
<!--
  插件卡（第 180 轮）：一个插件 = 一张卡。
    ┌──────────────────────────────────────────────┐
    │ [插头] 名称 ....................... [状态徽标] │  ›
    │        内置 · 失败后再试                       │
    │        ────────────────────────────────       │
    │        它声明的能力条目 1                    › │
    │        副标题                                 │
    └──────────────────────────────────────────────┘

  ★ 状态用**徽标**（生效中 / 待重启 / 已停用 / 已隔离），名称行不再重复一句
    「plugtest-v1 · 生效中（…装的那份）」—— 同一行里名字说两遍正是"文字堆积"的来源。
  ★ 安装时刻不再进列表（12sp 那行放不下「来源 · 处置 · 时刻」三样）：点开这一行进
    插件信息，那里有完整字段。
  ★ 整张卡可点（打开动作弹窗）；卡里的能力条目**自己也可点**（进那一条的页）——
    子 View 先拿到触摸，不会被父卡片吃掉（真机点过，见第 180 轮的验证记录）。
  ★ 外层 padding 提供卡间距、内层才是卡面 —— 与 item_slot / item_mod 同一形态。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="@dimen/card_gap">

    <LinearLayout
        android:id="@+id/plugin_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg_press"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="14dp"
            android:paddingEnd="12dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/ic_plugins_bar"
                android:tint="@color/accent" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- 名称最多一行：插件名通常很短，放不下就省略（完整名在动作弹窗的标题里） -->
                    <TextView
                        android:id="@+id/plugin_name"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/fg" />

                    <TextView
                        android:id="@+id/plugin_badge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/badge_slot"
                        android:paddingStart="8dp"
                        android:paddingEnd="8dp"
                        android:paddingTop="2dp"
                        android:paddingBottom="2dp"
                        android:textSize="11sp"
                        android:textColor="@color/chip_fg" />
                </LinearLayout>

                <TextView
                    android:id="@+id/plugin_meta"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="@color/fg_muted" />

                <!--
                  第 338 轮：**这一行只在真的有更新时出现**（没有就 GONE，卡片保持两行）。
                  ★ 用 accent 色把它跟上面那行"来源 · 处置"分开 —— 它是"有事要做"，不是静态信息。
                  ★ 文案由 PluginsActivity.updateLine 统一决定（已经生效的版本不会再显示"重启生效"）。
                -->
                <TextView
                    android:id="@+id/plugin_update"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="3dp"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="12sp"
                    android:textColor="@color/accent"
                    android:visibility="gone" />
            </LinearLayout>

            <ImageView
                android:layout_width="@dimen/row_chevron"
                android:layout_height="@dimen/row_chevron"
                android:layout_marginStart="6dp"
                android:src="@drawable/ic_chevron"
                android:tint="@color/fg_muted" />
        </LinearLayout>

        <!-- 插件声明的能力条目（第 139 轮）：没有就整块 GONE，卡片保持两行 -->
        <LinearLayout
            android:id="@+id/plugin_exts"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
