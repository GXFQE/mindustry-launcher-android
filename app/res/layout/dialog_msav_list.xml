<?xml version="1.0" encoding="utf-8"?>
<!--
  存档 / 地图的选择列表（对话框里的**卡片列表**）。

  ★ 用 ListView 而不是"把行全展开进 ScrollView"：这份列表可能有几百条（存档页那份就是），
    全展开会一次性 inflate 几百个视图。★ 这里是**对话框自己的窗口**，
    不存在 FLOWS F2b 那条"ScrollView 里套 ListView 高度塌掉"的问题（那条说的是页面里的嵌套）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
      ★ 表头（第 58 轮）：**条数/分组这类信息要放这里，不能塞标题**。
        AlertDialog 的标题是**单行**的（超了直接省略号），真机实测
        「槽「default」的地图\n本槽 0 · 游戏自带 114 · 模组自带 0」被截成
        「…模组自…」——标题里放多行内容必然出事。
    -->
    <TextView
        android:id="@+id/msav_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="6dp"
        android:paddingBottom="4dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      ★ 第 156 轮：「直接分享」这个**去处**收在动作自己的对话框里，页面上不多一行
        （与「导出统计」的四选一同一条：去处属于动作，不属于列表）。
        导出类调用方才会让它可见（删除那条路不传 ⇒ `GONE`）。

      ⚠️ 必须放在**列表上面**：列表是 `wrap_content`（`maxHeight` 对 ListView 不生效），
        116 份地图会把自定义内容顶出对话框可视区 —— 放在列表下面时真机上**根本看不到这一行**
        （2026-10-17 截图实测）。放上面还能保证滚动列表时它一直在。

      ★★ 2026-10-17 用户真机反馈两处，都在这一块：
        ① **对勾要跟列表里的对勾同列**（原来做成一个左对齐的裸 CheckBox ⇒ 方框在最左、
           文字缩进 100px，看着像"错位的一行"）⇒ 改成**一行**：文字在左、方框在右，
           与列表每行的方框对齐；
        ② **它得看起来像个可点的控件**（原来是一行没有边界的字，很不起眼）⇒ 整行可点
           （点字也算勾）+ 下沿一条分割线，把它和列表分开。
    -->
    <LinearLayout
        android:id="@+id/pick_share_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="20dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:background="?android:attr/selectableItemBackground"
        android:clickable="true"
        android:focusable="true"
        android:visibility="gone">

        <TextView
            android:id="@+id/pick_share"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="@color/fg"
            android:textSize="14sp" />

        <CheckBox
            android:id="@+id/pick_share_box"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>

    <View
        android:id="@+id/pick_share_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/divider"
        android:visibility="gone" />

    <ListView
        android:id="@+id/msav_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:maxHeight="420dp"
        android:divider="@null"
        android:scrollbarStyle="insideInset"
        android:dividerHeight="0dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:clipToPadding="false" />
</LinearLayout>
