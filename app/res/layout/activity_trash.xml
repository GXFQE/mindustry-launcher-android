<?xml version="1.0" encoding="utf-8"?>
<!--
  中转站页（TrashActivity，2026-10-05 第 102 轮）：删掉/被替换的地图与模组都在这儿，
  能看列表、能放回去、能彻底删除、能清空。

  ★ 骨架照抄 activity_maps.xml（表头 + 动作卡 + 空态 + 列表），理由是同一批老坑：
    · 根节点必须有 `@+id/root`，且 Activity 必须 `Util.applySystemInsets(root)` ——
      targetSdk ≥ 35 强制 edge-to-edge，漏了这一步整页从 y=0 开始画、被状态栏和顶栏盖住，
      而 view 在 uiautomator dump 里**还在**（自检 ㉛ 会拦住它）。
    · 空态必须排在列表容器 **之前**。

  ★★ 2026-10-16（第 151b 轮）：**根从 `LinearLayout` 改成 `ScrollView`，列表从 `ListView`
     改成手工挂载的 `LinearLayout`**（与主界面 F2c / 存档页 F3b 同一条口径）。
     原来那句"不在 ScrollView 里 ⇒ 没有 F2b 那条高度塌掉"只对**竖屏**成立：横屏可用高只有
     1224px(376dp) − ActionBar，顶部区一撑满，`weight` 子视图只能拿 0 ⇒ 列表被挤到屏幕外、
     根又不能滚 = 用户报的「横屏根本点不到下面」。
     ⚠️ `ScrollView` 里**不能**再放 `ListView`（只按单行估高 ⇒ 滚不到底，F3b 的 AOSP 公式级根因）。

  ★ 为什么"清空"要做成一个动作行而不是列表末尾一项：它是**不可逆**的动作，混在可点开的
    条目里手指一滑就点上了。放顶上、单独一张卡，和地图页"导入 / 导出在顶上"同一套排布。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/trash_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/trash_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp">

        <include
            android:id="@+id/row_trash_empty_all"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- 2026-10-25 用户「能不能给中转站加一个分类」：按类型筛选（副标题由代码填当前分类与份数）。
             ★ 排在"清空"之后：下面那条是不可逆动作，筛选是看的动作，别让它先占最上面一格。 -->
        <include
            android:id="@+id/row_trash_filter"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!-- 第 160 轮：插件动作区（没有条目整块 GONE）；与 trash_actions 一样再留 14dp -->
    <include
        layout="@layout/plugin_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/trash_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/fg_muted"
        android:visibility="gone" />

    <!-- ★★ 列表容器：不是 `ListView`（见文件头 2026-10-16 那条）；行由 `MsavListAdapter.fillInto` 手工挂载 -->
    <LinearLayout
        android:id="@+id/trash_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />
  </LinearLayout>
</ScrollView>
