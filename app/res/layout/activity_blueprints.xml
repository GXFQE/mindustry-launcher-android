<?xml version="1.0" encoding="utf-8"?>
<!--
  蓝图列表页（F22，2026-10-05 第 109 轮）：从槽二级页面点「蓝图」进来。

  ★ 结构照抄 activity_maps。
  ★ 这一轮**只读**：还没有导入/导出（那是 F22 的下一步），所以没有动作行，
    只有一行表头 + 列表 + 空态。

  ★★ 2026-10-16（第 151b 轮）：**根从 `LinearLayout` 改成 `ScrollView`，列表从 `ListView`
     改成手工挂载的 `LinearLayout`**（与主界面 F2c / 存档页 F3b 同一条口径）。
     原来那句"不在 ScrollView 里 ⇒ 没有 F2b 那条高度塌掉"只对**竖屏**成立：
     横屏可用高只有 1224px(376dp) − ActionBar，顶部区（表头 + 动作卡 + 搜索框）一撑满，
     `weight` 子视图只能拿 0 ⇒ 搜索框与整张列表被挤到屏幕外、根又不能滚
     = 用户报的「横屏根本点不到下面」。
     ⚠️ `ScrollView` 里**不能**再放 `ListView`（它只按单行估高 ⇒ 滚不到底，F3b 的 AOSP 公式级根因）。

  🔴 根节点必须有 `@+id/root`，且 Activity 必须调 `Util.applySystemInsets(root)`：
     targetSdk ≥ 35 强制 edge-to-edge ⇒ 漏了这一步整页从 y=0 开始画、被状态栏 + 顶栏整块盖住，
     而且**全程不报错**（第 81 轮踩过，自检 ㉛ 会拦）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/bp_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp" />

    <!--
      ★★ 导入 / 导出**放页面顶上**（与地图页同一条定案，用户 2026-10-03：「导入和导出都放页面顶上吧」）：
        动作行放底部会盖住列表末行、手指按在它上面时列表滑不动。
      ⚠️ 两行都 `<include>` 同一个 `row_action` ⇒ id 会重复，代码里必须**从行根** findViewById
         （`Util.bindAction` 已经这么做了；见 FLOWS F2b 第二条坑）。
    -->
    <LinearLayout
        android:id="@+id/bp_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp">

        <include
            android:id="@+id/row_bp_import"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <include
            android:id="@+id/row_bp_export"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <!--
          ★ 2026-10-11（第 129 轮）：**批量删除**（地图 / 蓝图两页各一行，共用一份实现）。
          判据三条：只有**槽里这一类目录的直接子项**删得动（模组包 / 游戏自带 / 子目录里的都删不了，
          界面会明说几份删不了）· 旧件一律**挪进中转站**（`Trash.move`，跨卷安全）· 游戏在跑时挡住
          （与单份删除同一道门）。细则 REF §90.7。
        -->
        <include
            android:id="@+id/row_bp_del"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <!--
          ★ 2026-10-07（第 122 轮）：「筛选与排序」（搜索词 + 排序 + 只看有问题的）。
          这一页的「有问题的」= **缺件或解析不了** —— 那正是这一页存在的理由
          （游戏那边缺件是静默的，只能在这里提前看见）。判据见 `Blueprints.isProblem`。
          纯前端：只筛内存里已经解析好的那份清单，一个文件都不碰。
        -->
        <include
            android:id="@+id/row_bp_filter"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!--
      搜索框（第 122 轮）：与模组 / 地图页同一个形状 —— 就在列表正上方。
      ⚠️ 提示语在 Java 里绑（`Trans.bind`）：布局够不到用户语言包。
    -->
    <EditText
        android:id="@+id/bp_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:layout_marginTop="2dp"
        android:inputType="text"
        android:maxLength="60"
        android:singleLine="true"
        android:textColor="@color/fg"
        android:textColorHint="@color/fg_muted"
        android:textSize="15sp" />

    <!-- 筛选状态（只有真的在筛选时才显示；见 BlueprintsActivity.rebuildList） -->
    <TextView
        android:id="@+id/bp_filtered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="6dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      ★ 空态。位置必须在 ListView **之前**：下面那个 ListView 是 `weight=1`（吃掉剩余高度），
        空态若排在它后面就会被顶到屏幕最底部（见 activity_maps.xml 的同一条注释）。
    -->
    <TextView
        android:id="@+id/bp_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/fg_muted"
        android:visibility="gone" />

    <!-- ★★ 列表容器：不是 `ListView`（见文件头 2026-10-16 那条）；行由 `MsavListAdapter.fillInto` 手工挂载 -->
    <LinearLayout
        android:id="@+id/bp_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />

    <!-- 第 163 轮：底部留白 —— 与另外三页同一份（原来只有模组页有） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_bottom_space" />
  </LinearLayout>
</ScrollView>
