<?xml version="1.0" encoding="utf-8"?>
<!--
  资源页的一类（第 171 轮，第 172 轮对齐列表样式）。

  形状与 `item_msav` 一致：
    外层 padding 10/10/4/4（卡片外边距）
      └ 内层 card_bg_press（点按高亮）
          ├ 标题 15sp / 副标题 12sp 灰字
          └ 右侧 CheckBox（clickable=false：整行点击交给代码，避免点框反而没反应）
  ★ 不用“一大张卡里塞 12 行”：地图 / 存档 / 蓝图 / 模组页的列表都是逐条卡片，
    这一页也逐条，视觉边界才一致。
  ★ 文字由 Activity 用 Trans 写入，XML 不写 android:text。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/resources_group_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/card_bg_press"
        android:clickable="true"
        android:focusable="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/resources_group_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:singleLine="true"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/resources_group_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/resources_group_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:clickable="false"
            android:focusable="false" />
    </LinearLayout>
</LinearLayout>
