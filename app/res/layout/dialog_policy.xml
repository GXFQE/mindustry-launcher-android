<?xml version="1.0" encoding="utf-8"?>
<!--
  F5b：槽的自动备份策略表单（AlertDialog.setView 的载体）。

  ★ 为什么用 XML 而不是代码拼：与设置页/存档页同款「标题 + 说明 + 输入」节奏，
    改版式只动这一份；也让「实时摘要」那块 accent_soft 底能走资源（深浅自动跟随）。

  ★ 为什么外面套 ScrollView：横屏可用高只有 376dp，而
    「标题 + 开关 + 两段说明 + 两个输入框 + 按钮」在竖屏已经有 ~1000px 高 ⇒
    横屏必超。套上 ScrollView 后「保存」永远点得到。

  ★ 禁用态（关掉「启用自动备份」时）由代码置灰 pol_min_box / pol_max_box 并 setEnabled(false)，
    这里不写死。

  ⚠️ 这个对话框**不要**用 setMessage：同一对话框里 setMessage + setView/items 会互相吞
    （F3b 真机实测，见 FLOWS.md F3b）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <CheckBox
            android:id="@+id/pol_enabled"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/policy_enabled"
            android:textColor="@color/fg"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/policy_enabled_hint"
            android:textColor="@color/fg_muted"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />

        <!-- ── 最小备份时间 ── -->
        <LinearLayout
            android:id="@+id/pol_min_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/policy_min"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/policy_min_hint"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/pol_min"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:inputType="number"
                android:maxLength="6"
                android:singleLine="true"
                android:textColor="@color/fg"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ── 最大备份数量 ── -->
        <LinearLayout
            android:id="@+id/pol_max_box"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/policy_max"
                android:textColor="@color/fg"
                android:textSize="14sp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="2dp"
                android:text="@string/policy_max_hint"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/pol_max"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:inputType="number"
                android:maxLength="4"
                android:singleLine="true"
                android:textColor="@color/fg"
                android:textSize="16sp" />
        </LinearLayout>

        <!-- ── 实时摘要：改一个数字立刻反映结果，省得用户自己心算 ── -->
        <TextView
            android:id="@+id/pol_live"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/pol_live_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/fg"
            android:textSize="12sp"
            android:lineSpacingExtra="2dp" />
    </LinearLayout>
</ScrollView>
