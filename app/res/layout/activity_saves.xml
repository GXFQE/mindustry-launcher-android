<?xml version="1.0" encoding="utf-8"?>
<!--
  某个槽的**存档列表页**（2026-10-06 第 115 轮第六批）：从槽二级页面点「存档」进来。

  ★ 起因（用户）：「存档页面也变成和模组 / 地图 / 蓝图这样的二级页面吧」。
    原来这里是**弹窗菜单**（看每份存档… / 导出存档… / 导入存档…），
    而模组 / 地图 / 蓝图那三条早就是**页面**了 ⇒ 存档补齐同一形状。

  ★ 结构照抄 `activity_blueprints`：表头 + 动作行放顶上
    （用户 2026-10-03 定案：动作行放底部会盖住列表末行）。

  ★★ 2026-10-16（第 151b 轮）：**根从 `LinearLayout` 改成 `ScrollView`，列表从 `ListView`
     改成手工挂载的 `LinearLayout`**（与主界面 F2c / 存档页 F3b 同一条口径）。
     原来那句"不套 ScrollView ⇒ 没有 F2b 那条高度塌掉"只对**竖屏**成立：
     横屏可用高只有 1224px(376dp) − ActionBar，顶部区一撑满，`weight` 子视图只能拿 0
     ⇒ 搜索框与整张列表被挤到屏幕外、根又不能滚 = 用户报的「横屏根本点不到下面」。
     ⚠️ `ScrollView` 里**不能**再放 `ListView`（它只按单行估高 ⇒ 滚不到底，F3b 的 AOSP 公式级根因）。

  🔴 根节点必须有 `@+id/root`，且 Activity 必须调 `Util.applySystemInsets(root)`：
     targetSdk ≥ 35 强制 edge-to-edge ⇒ 漏了这一步整页从 y=0 开始画、被状态栏 + 顶栏整块盖住，
     而且**全程不报错**（第 81 轮踩过，自检 ㉛ 会拦）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!--
      ★ 表头（份数这类信息**不能塞标题**：ActionBar 标题是单行的，超了直接省略号，
        见 dialog_msav_list.xml 里那条真机实测）。
    -->
    <TextView
        android:id="@+id/save_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/save_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp">

        <include
            android:id="@+id/row_save_import"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <include
            android:id="@+id/row_save_export"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <!--
          ★ 第 157 轮：存档也能删（与地图 / 蓝图 / 模组同一套：旧件挪进中转站）。
            用户 2026-10-17：「地图和蓝图能删，存档和模组又不能删」。
          ⚠️ 不碰 `saves/` 之外的东西（`BatchIo.deletable` 是唯一判据）。
        -->
        <include
            android:id="@+id/row_save_del"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!--
          ★ **只在真有读不出来的存档时出现**（`SavesActivity.refresh()` 按
            `MsavMeta.summarize` 的数决定显隐）—— 与槽页副标题那句 ⚠ 同一个口径。
          ⚠️ 它连同**它上面那条分割线**一起显隐（线要有 id，别只处理行 —— 第 115 轮第二批踩过）。
        -->
        <View
            android:id="@+id/div_save_bad"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider"
            android:visibility="gone" />

        <include
            android:id="@+id/row_save_bad"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <!--
          ★ 2026-10-07（第 122 轮）：「筛选与排序」（搜索词 + 排序：名称 / 最新在前 / 大小）。
          这一页**没有**"只看有问题的"：存档的"读不出来"已经有专用入口（上面那一行
          →「哪几份读不出来」），再来一个开关就是同一件事两个入口（F15b 的教训）。
          纯前端：只筛内存里的那份清单，一个文件都不动。
        -->
        <include
            android:id="@+id/row_save_filter"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!--
      搜索框（第 122 轮）：与模组 / 地图 / 蓝图页同一个形状 —— 就在列表正上方。
      ⚠️ 提示语在 Java 里绑（`Trans.bind`）：布局够不到用户语言包。
    -->
    <EditText
        android:id="@+id/save_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:layout_marginTop="2dp"
        android:inputType="text"
        android:maxLength="60"
        android:singleLine="true"
        android:textColor="@color/fg"
        android:textColorHint="@color/fg_muted"
        android:textSize="15sp" />

    <!-- 筛选状态（只有真的在筛选时才显示；见 SavesActivity.rebuildList） -->
    <TextView
        android:id="@+id/save_filtered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="6dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      ★ 空态位置必须在 ListView **之前**：下面那个 ListView 是 `weight=1`（吃掉剩余高度），
        空态若排在它后面就会被顶到屏幕最底部（见 activity_maps.xml 的同一条注释）。
    -->
    <TextView
        android:id="@+id/save_empty"
        style="@style/PageEmpty"
        android:visibility="gone" />

    <!-- ★★ 列表容器：不是 `ListView`（见文件头 2026-10-16 那条）；行由 `SlotIo.fillSaves` 手工挂载 -->
    <LinearLayout
        android:id="@+id/save_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />

    <!-- 第 163 轮：底部留白 —— 四页必须同一份（模组页一直有，这三页漏了 ⇒
         滚到底时末项离导航栏比模组页更近；用户：「顶上和底下也不一样」） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_bottom_space" />
  </LinearLayout>
</ScrollView>
