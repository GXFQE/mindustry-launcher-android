<?xml version="1.0" encoding="utf-8"?>
<!--
  某个槽的**存档列表页**（2026-10-06 第 115 轮第六批）：从槽二级页面点「存档」进来。

  ★ 起因（用户）：「存档页面也变成和模组 / 地图 / 蓝图这样的二级页面吧」。
    原来这里是**弹窗菜单**（看每份存档… / 导出存档… / 导入存档…），
    而模组 / 地图 / 蓝图那三条早就是**页面**了 ⇒ 存档补齐同一形状。

  ★ 结构照抄 `activity_blueprints`：页面自己的 ListView（**不套 ScrollView** ⇒ 没有 F2b 那条"高度塌掉"）+
    表头 + **动作行放顶上**（用户 2026-10-03 定案：动作行放底部会盖住列表末行）。

  🔴 根节点必须有 `@+id/root`，且 Activity 必须调 `Util.applySystemInsets(root)`：
     targetSdk ≥ 35 强制 edge-to-edge ⇒ 漏了这一步整页从 y=0 开始画、被状态栏 + 顶栏整块盖住，
     而且**全程不报错**（第 81 轮踩过，自检 ㉛ 会拦）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <!--
      ★ 表头（份数这类信息**不能塞标题**：ActionBar 标题是单行的，超了直接省略号，
        见 dialog_msav_list.xml 里那条真机实测）。
    -->
    <TextView
        android:id="@+id/save_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/save_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp">

        <include
            android:id="@+id/row_save_import"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <include
            android:id="@+id/row_save_export"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!--
          ★ **只在真有读不出来的存档时出现**（`SavesActivity.refresh()` 按
            `MsavMeta.summarize` 的数决定显隐）—— 与槽页副标题那句 ⚠ 同一个口径。
          ⚠️ 它连同**它上面那条分割线**一起显隐（线要有 id，别只处理行 —— 第 115 轮第二批踩过）。
        -->
        <View
            android:id="@+id/div_save_bad"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider"
            android:visibility="gone" />

        <include
            android:id="@+id/row_save_bad"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!--
      ★ 空态位置必须在 ListView **之前**：下面那个 ListView 是 `weight=1`（吃掉剩余高度），
        空态若排在它后面就会被顶到屏幕最底部（见 activity_maps.xml 的同一条注释）。
    -->
    <TextView
        android:id="@+id/save_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="28dp"
        android:gravity="center"
        android:textAlignment="center"
        android:textSize="13sp"
        android:lineSpacingExtra="4dp"
        android:textColor="@color/fg_muted"
        android:visibility="gone" />

    <ListView
        android:id="@+id/save_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false" />
</LinearLayout>
