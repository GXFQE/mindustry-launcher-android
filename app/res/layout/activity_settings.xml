<?xml version="1.0" encoding="utf-8"?>
<!--
  F3：全局设置页骨架（与 activity_main / activity_saves 同款卡片风）。

  第 174 轮：**按类别拆成三张卡**（用户：「设置真的应该分个类，后面数量多了可能非常难找」）：
    外观与语言  —— 深浅色 / 语言 / 翻译文件
    启动与存储  —— 默认槽 / 自动清理 / 中转站保留份数 / 存储占用
    通知与日志  —— 崩溃提示 / 日志保留份数
    关于        —— 只读信息

  ★ 判据没变：本页只放**所有槽共用、能被改的项**；按槽生效的（自动备份三件套）仍在存档页。
    「中转站」「运行日志」是页面入口，仍在主界面工具卡 —— 分区不是为了把它们搬回来。
  ★ 结构仍是 ScrollView + 手工挂载的 LinearLayout（横屏可用高 376dp；ListView 会被压扁）。
  ★ 根节点必须有 `@+id/root`，Activity 必须调 `Util.applySystemInsets(root)`。
  ★ 所有可见文字都由 SettingsActivity 用 Trans 写入；XML 里不写 android:text。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- ══ 外观与语言 ══════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/settings_section_appearance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="6dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_theme"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_language"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_lang_pack"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ══ 启动与存储 ══════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/settings_section_startup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_def_slot"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!-- F20：自动清理数据根残留（开关） + 手动清理入口。 -->
                <include
                    android:id="@+id/row_auto_clean"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!-- 第 173 轮：中转站保留份数（普通条目 / 整个槽分开）。 -->
                <include
                    android:id="@+id/row_trash_keep"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!-- 存储占用：只读弹窗，但弹窗里带「清理缓存」动作。 -->
                <include
                    android:id="@+id/row_storage"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- ══ 通知与日志 ══════════════════════════════════════════════ -->
            <TextView
                android:id="@+id/settings_section_alerts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <!-- 第 174 轮：崩溃提示总开关（默认开；关掉不影响报告落盘/分析）。 -->
                <include
                    android:id="@+id/row_crash_alert"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!-- F7：日志保留份数（设置值，不是页面入口）。 -->
                <include
                    android:id="@+id/row_logs"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!--
              关于：第 175 轮从「设置页内联信息卡」改成**独立二级页入口**。
              ★ 这是设置页唯一一个"点开是另一个页面"的行 —— 理由：版本 / 包名 / 数据路径 /
                开源地址属于"看"而不是"改"，塞在设置里既占地方又打乱三类设置的分区。
              （「中转站」「运行日志」仍不许搬回设置；它们主界面有工具卡。）
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_about"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 第 160 轮：插件动作区（没有条目整块 GONE）；单独一张卡，不混进设置项 -->
            <include layout="@layout/plugin_section" />
        </LinearLayout>

        <!-- F5b：底部留白（滚到底时末项与导航栏留出间隙）。见 activity_main.xml -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_bottom_space" />
    </LinearLayout>
</ScrollView>
