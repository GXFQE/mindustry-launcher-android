<?xml version="1.0" encoding="utf-8"?>
<!--
  F3：全局设置页骨架（与 activity_main / activity_saves 同款卡片风）。

  结构：
    外层 ScrollView（整页滚，横竖屏通用）
      └ 内层 LinearLayout（vertical）
          ├ 设置项卡   —— row_action（复用：副标题显示"当前值"）
          └ 关于卡     —— 只读信息（版本 / 包名 / 数据根 / HUB）

  ★ 为什么是 ScrollView：与另两页同因（横屏可用高仅 376dp，竖着放不下会压扁内容）。
  ★ 为什么列表/条目用 LinearLayout 而非 ListView：见 MainActivity.rebuildList() 的注释（F3b 根因）。
  ★ 根节点不设 padding：Util.applySystemInsets() 会写 root 的 padding（四边叠加）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <!-- 设置项：只有"所有槽共用"的项才放这里；按槽生效的项在存档页的槽菜单里 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/card_bg">

                <!--
                  F15：深浅色。排在最上面 —— 它是纯"外观"项，且是用户最常回来改的一项
                  （晚上想变深、白天想变浅），放第一个最省一次滑动。
                  副标题显示当前值（与「默认槽 / 日志保留份数」同款：内容即当前状态）。
                -->
                <include
                    android:id="@+id/row_theme"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  P2：界面语言。紧挨着深浅色 —— 这两项是 BaseActivity **在同一个
                  Configuration 上一起写**的（uiMode 的 night 位 + locale 位），
                  也都是"改完立刻重建本页"的项，放一起用户找得到。
                  副标题显示当前值（与深浅色 / 默认槽同款：内容即当前状态）。
                -->
                <include
                    android:id="@+id/row_language"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_def_slot"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_logs"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!-- F7：运行日志入口。放在「日志保留份数」下方 —— 一个是"留多少份"，
                     一个是"到哪看"，本来就是同一件事的两半，挨着才对。 -->
                <include
                    android:id="@+id/row_open_logs"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  F20：自动清理数据根残留（开关）。
                  ★ 放在这张卡的末位：前四项用户天天改，这一项一年碰不了一次。
                  ★ 这一行同时是「手动清理」的入口 —— 关掉自动之后仍要能清，
                    否则用户一关就再没有别的办法（第 57 轮把体检入口删掉了）。
                -->
                <include
                    android:id="@+id/row_auto_clean"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  存储占用（一档③+⑦，2026-10-06）。★ 放在「自动清理」与「中转站」之间：
                    它统计的正是"各槽 / 备份 / 中转站"各占多少，而下一行就是中转站本体 ——
                    用户看完"中转站占了 120 MB"接着就想进去处理它。
                  ★ 只读弹窗：数字在后台算（要遍历对象池与所有槽），所以点开先显示"正在统计…"。
                  ★ 为什么不单开一页：这一页只有数字、没有交互 ⇒ 弹窗足够，
                    也省掉"新页面必须补 insets / 继承 BaseActivity / 注册清单"这三件都踩过的事。
                -->
                <include
                    android:id="@+id/row_storage"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  中转站（2026-10-05，第 102 轮）。★ 放在这张卡的**末位**：
                    前几项用户天天改，这一项只在"东西被删了想找回来"时才来。
                  ★ 为什么入口在**全局设置页**而不是某个槽里：中转站是 per-hub 的、不属于任何槽
                    （地图与模组的中转站是同一个地方），塞进槽页会让用户以为里面只有这个槽的东西。
                    放回去时**再选目标槽**，那一问在页面里。
                -->
                <include
                    android:id="@+id/row_trash"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 关于：只读，不参与交互 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:orientation="vertical"
                android:background="@drawable/card_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="14dp"
                android:paddingBottom="14dp">

                <TextView
                        android:id="@+id/tx_about_card_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fg" />

                <TextView
                    android:id="@+id/about_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp"
                    android:textIsSelectable="true"
                    android:textColor="@color/fg_muted" />
            </LinearLayout>
        </LinearLayout>

        <!-- F5b：底部留白（滚到底时末项与导航栏留出间隙）。见 activity_main.xml -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_bottom_space" />
    </LinearLayout>
</ScrollView>
