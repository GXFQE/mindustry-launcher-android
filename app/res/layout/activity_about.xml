<?xml version="1.0" encoding="utf-8"?>
<!--
  「关于」二级页（第 175 轮）。

  从设置页底部搬出来：版本 / 包名 / 数据位置 / 开源地址 / 许可证 / 问题反馈。
  结构照设置页：整页 ScrollView + 卡片 + 12sp 灰字分区标题；根节点必须有 @+id/root
  （targetSdk ≥ 35 强制 edge-to-edge；Activity 必须调 Util.applySystemInsets(root)）。

  ★ 所有可见文字都由 AboutActivity 用 Trans 写入；XML 里不写 android:text。
  ★ 外部链接只有 URL 资源（translatable=false），显示文案在 values / values-zh。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad"
            android:paddingTop="12dp"
            android:paddingBottom="14dp">

            <TextView
                android:id="@+id/about_app_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/fg"
                android:textSize="20sp" />

            <TextView
                android:id="@+id/about_summary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/about_section_links"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_about_repo"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_about_issues"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_about_license"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_section_data"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="18dp"
                android:paddingBottom="6dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:id="@+id/about_data"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:lineSpacingExtra="3dp"
                    android:textColor="@color/fg_muted"
                    android:textIsSelectable="true"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/about_footer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="4dp"
                android:paddingEnd="4dp"
                android:paddingTop="18dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_bottom_space" />
    </LinearLayout>
</ScrollView>
