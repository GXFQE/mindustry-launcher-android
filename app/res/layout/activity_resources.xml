<?xml version="1.0" encoding="utf-8"?>
<!--
  游戏资源页（第 171 轮，第 172 轮对齐四页风格）：长按版本 → 详情里的「资源」。

  结构照 maps / saves / blueprints / mods 四页：
    整页 ScrollView（横竖屏通用）
      ├ 顶部灰字摘要（12sp · fg_muted · 左右 20dp · 上 12dp · 下 6dp）
      ├ 说明（同一规格，第二行）
      ├ 操作卡（card_bg · 左右 14dp · 下 8dp）：全选 / 全不选 / 导出选中…
      ├ 空态（style/PageEmpty，排在列表前）
      ├ 列表容器（逐条卡片，条目自己带 10dp 外边距，与 item_msav 同款）
      └ 底部留白（@dimen/page_bottom_space）

  ★ 根节点必须有 @+id/root，Activity 必须调 Util.applySystemInsets(root) ——
    targetSdk ≥ 35 强制 edge-to-edge；漏了整页从 y=0 开始画、被状态栏 + 顶栏盖住。
  ★ 不再自造“固定底部导出栏”：四页的导出动作都在顶部操作卡里，用户按页面
    从上往下读；固定底栏会多出一层与其它页不同的结构（2026-10-19 用户：
    「感觉这个页面和其他页面风格有点不搭啊」）。
  ★ 本页所有可见文字都由 Activity 用 Trans 写入；XML 里不写 android:text。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/resources_head"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingTop="12dp"
            android:paddingBottom="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/fg_muted"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/resources_note"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="20dp"
            android:paddingEnd="20dp"
            android:paddingBottom="6dp"
            android:lineSpacingExtra="2dp"
            android:textColor="@color/fg_muted"
            android:textSize="12sp" />

        <LinearLayout
            android:id="@+id/resources_actions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/card_bg"
            android:orientation="vertical"
            android:visibility="gone">

            <include
                android:id="@+id/row_resources_all"
                layout="@layout/row_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:background="@color/divider" />

            <include
                android:id="@+id/row_resources_none"
                layout="@layout/row_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="62dp"
                android:background="@color/divider" />

            <include
                android:id="@+id/row_resources_export"
                layout="@layout/row_action"
                android:layout_width="match_parent"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <TextView
            android:id="@+id/resources_empty"
            style="@style/PageEmpty"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/resources_groups"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="8dp" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_bottom_space" />
    </LinearLayout>
</ScrollView>
