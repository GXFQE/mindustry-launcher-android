<?xml version="1.0" encoding="utf-8"?>
<!--
  插件页（第 132 轮，2026-10-12；第 180 轮改版：从"一列文字"改成卡片 + 分区）。

  结构（自上而下）：
    ┌ 跳过横幅（上次带插件启动没成功；有记录才出现）
    ├ 「已安装」分区标题（有插件时才出现）
    ├ 插件卡（名称 / 状态徽标 / 来源·处置 / 它声明的能力条目）
    ├ 空态卡（一个插件都没有时）
    ├ 安装卡（row_action：装一个插件 APK）
    └ 重启卡（row_action：立即重启管理器）

  ★ 动态区（`plugins_dynamic`）与底部两张静态卡分开：静态卡只绑一次
    （`Util.bindActionValue`），`rebuild()` 只清动态区 —— 否则每次回来都要重绑一遍。
  ★ 根节点必须有 `@+id/root`，且 Activity 必须调 `Util.applySystemInsets(root)` ——
    targetSdk ≥ 35 强制 edge-to-edge；没有这一步**整页从屏幕 y=0 开始画**，被状态栏 + 顶栏盖住。
    ⚠️ 别改成 `android:fitsSystemWindows="true"`（Util.java 里有定论：edge-to-edge 下不可靠）。
  ★ 本页不含标题：顶栏（ActionBar）已经在显示「插件」—— 同一屏同一件事只说一次。
  ★ 说明性文字只在对应动作的副标题里出现一次（安装 = 这是什么；重启 = 什么时候需要）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/plugins_scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbarStyle="outsideOverlay">

        <LinearLayout
            android:id="@+id/plugins_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad"
            android:paddingTop="12dp"
            android:paddingBottom="24dp">

            <!-- 动态区：跳过横幅 / 「已安装」标题 / 插件卡 / 空态卡（PluginsActivity.rebuild） -->
            <LinearLayout
                android:id="@+id/plugins_dynamic"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />

            <!-- 安装（页面级动作，永远在列表下面） -->
            <LinearLayout
                android:id="@+id/plugins_install_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_plugin_install"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <!-- 重启（插件的改动都要退出重开才生效；按钮一直给着，别让用户找不到） -->
            <LinearLayout
                android:id="@+id/plugins_restart_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/card_gap"
                android:background="@drawable/card_bg"
                android:orientation="vertical">

                <include
                    android:id="@+id/row_plugin_restart"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
