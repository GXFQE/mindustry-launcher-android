<?xml version="1.0" encoding="utf-8"?>
<!--
  F13：模组管理页骨架（与 activity_saves / activity_settings 同款卡片风）。

  结构：
    外层 ScrollView（整页滚，横竖屏通用）
      └ 内层 LinearLayout（vertical）
          ├ 顶部区（随整页滚）
          │   ├ 状态摘要卡 —— 「N 个模组 · 槽 X · 目标游戏 Y」，点开是完整路径与设置侧说明
          │   └ 操作卡    —— 「查看的槽」（只读切换，用来做跨槽模组视图）
          ├ 模组列表容器（LinearLayout，条目由代码 addView 全展开）
          └ 空态 TextView

  ★★ 为什么必须是 ScrollView / 为什么列表容器不能用 ListView：
     与 activity_main / activity_saves 同因（横屏可用高 376dp；ScrollView 给子级的高度约束
     是 UNSPECIFIED，ListView 在那个分支只按「padding + 单行」估高、条目不展开
     ⇒ 外层滚动范围少算、底部条目永远滚不出来）。详见 activity_main.xml 顶部注释。
  ★ 根节点不设 padding：Util.applySystemInsets() 会写 root 的 padding（四边叠加）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true"
    android:scrollbars="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- 状态摘要行：**长得和另外三页顶部那行灰字一样**（第 163 轮）
                 ⚠️ 原来是 `card_bg_press` 的卡片 ⇒ 四页里只有模组顶部是"卡片"、卡片左右还是
                    16dp（其余三页 14dp），用户一眼就看出来不是一套（「顶上和底下也不一样」）。
                 ★ 功能一点没少：仍然可点、仍然展开 `mods_detail`、仍有 chevron —— 只是不再套卡片底色。
                 规格对齐 activity_saves.xml 的 `save_head`：左右 20dp · 上 12dp · 下 6dp · 12sp 灰字。 -->
            <LinearLayout
                android:id="@+id/mods_status_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clickable="true"
                android:focusable="false"
                android:paddingStart="20dp"
                android:paddingEnd="20dp"
                android:paddingTop="12dp"
                android:paddingBottom="6dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/mods_summary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:singleLine="true"
                        android:ellipsize="end"
                        android:textSize="12sp"
                        android:textColor="@color/fg_muted" />

                    <ImageView
                        android:id="@+id/mods_chevron"
                        android:layout_width="@dimen/row_chevron"
                        android:layout_height="@dimen/row_chevron"
                        android:layout_marginStart="8dp"
                        android:src="@drawable/ic_chevron"
                        android:tint="@color/fg_muted" />
                </LinearLayout>

                <!-- ══ 「上次启动没跑完」是**全槽级**的事实，只在这里说一次（2026-10-08） ══
                     ★ 为什么从每一行搬到这里：游戏自己在 settings 里把**本槽全部**模组都标成
                       failed（那是它"下次整槽跳过"的机制）⇒ 逐行显示会被读成"这个模组出过错"
                       （用户真机反馈："为什么无关模组也被判定到了"）。
                       按行只标**归因器真正点名**的那一个（`mods_warn_blamed`）。 -->
                <TextView
                    android:id="@+id/mods_fail_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/fg"
                    android:visibility="gone" />

                <!-- ══ F23：上次崩溃的归因结论（一行） ══════════════════════════════
                     ★ 为什么放这里（摘要卡里、**在可展开的详情之外**）：模组页是"为什么它没生效"
                       的入口页，而"上次崩了、很可能是谁干的"正是同一类问题的另一半答案；
                       放在详情里就等于默认藏着（用户得先想到点开）。
                     ★ 为什么默认 GONE：没有崩溃报告 / 结论是"认不出"时**不占位、不说废话**
                       （这行的值由 ModsActivity.refreshCrashVerdict 在后台算，见那里的注释）。 -->
                <TextView
                    android:id="@+id/mods_verdict"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="6dp"
                    android:textSize="13sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="@color/fg"
                    android:visibility="gone" />

                <TextView
                    android:id="@+id/mods_detail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingTop="8dp"
                    android:textSize="11sp"
                    android:lineSpacingExtra="4dp"
                    android:textColor="@color/fg_muted"
                    android:visibility="gone" />
            </LinearLayout>

            <!-- 操作卡：只读的槽切换（模组住在槽里 ⇒ 跨槽视图就是"换个槽看"）
                 第 163 轮：左右边距 16dp → **14dp**（原来外层那圈 page_pad 顺手把卡片也缩成 16dp，
                 而另外三页的卡片是 14dp ⇒ 四页卡片宽度不一致）；`marginTop` 也去掉 ——
                 状态行自己已有 6dp 下边距，再叠 card_gap 就比别的页多一截。 -->
            <LinearLayout
                android:id="@+id/mods_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"
                android:layout_marginBottom="8dp"
                android:orientation="vertical"
                android:background="@drawable/card_bg">

                <include
                    android:id="@+id/row_mod_slot"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:id="@+id/div_mod_slot"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  F13 第三阶段：进口（导入模组包）与跨槽复制。
                  ★ 与「查看的槽」同卡 —— 三件事都作用于**当前正在看的那个槽**，
                    这是 F15b 那条纪律的落点："导入的落点必然是某个东西"，所以
                    "从那个东西进去"最省事，也不需要在别处再开第二个入口。
                -->
                <include
                    android:id="@+id/row_mod_import"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  第 127 轮（批量导入导出）：模组这条线原来**只有进口没有出口**
                  （整槽 zip 那条出口把模组混在里面，拿不出"单独某几个模组"）。
                  ★ 第 157 轮（用户：「导入导出不相邻」）：**紧跟在导入下面** ——
                    原来中间夹着「复制到其他槽」，四个页面里只有这一页是"进 / 别的动作 / 出"。
                    四个内容页的顺序统一成：导入 → 导出 → 本页专属 → 删除 → 筛选。
                -->
                <include
                    android:id="@+id/row_mod_export"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_mod_copy"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  模组间冲突体检（用户问：「能检查到 logicsugar 和 neon 同时加载吗」）。
                  ★ 放在**按需**一行里：它要读每个 Java 模组的 classes.dex（可能十几 MB），
                    不适合每次进页面都跑。
                -->
                <include
                    android:id="@+id/row_mod_conflict"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_mod_batch"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <!--
                  ★ 第 157 轮：模组也能删了（与地图 / 蓝图 / 存档同一套：旧件挪进中转站）。
                    四个页面都能删是用户 2026-10-17 拍的：「地图和蓝图能删，存档和模组又不能删」。
                  ⚠️ 模组包里自带的条目删不了（它们住在那个 zip 里）—— 由 `BatchIo.deletable` 挡，
                    并计进「删不了 N 份」，不是报失败。
                -->
                <include
                    android:id="@+id/row_mod_del"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="62dp"
                    android:background="@color/divider" />

                <include
                    android:id="@+id/row_mod_filter"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </LinearLayout>

        <!-- v24（第 225 轮）：插件段落（`slot: section`, `page: mods`）。
             没条目时整块 GONE（ModsActivity 里按 rows 有没有孩子决定）。
             外面包一层给左右 14dp —— include 的根布局自己没有边距。 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:orientation="vertical">

            <include layout="@layout/plugin_section" />
        </LinearLayout>

        <!-- 搜索框（第②项：排序/筛选/搜索）—— 纯前端过滤，**不改任何文件** -->
        <EditText
            android:id="@+id/mod_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_pad"
            android:layout_marginEnd="@dimen/page_pad"
            android:layout_marginTop="2dp"
            android:inputType="text"
            android:maxLength="60"
            android:singleLine="true"
            android:textColor="@color/fg"
            android:textColorHint="@color/fg_muted"
            android:textSize="15sp" />

        <!-- 筛选状态（只有真的在筛选时才显示） -->
        <TextView
            android:id="@+id/mod_filtered"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad"
            android:paddingTop="6dp"
            android:textColor="@color/fg_muted"
            android:textSize="12sp"
            android:visibility="gone" />
        <!-- ★ 空态排在**列表容器之前** —— 第 166 轮把这两块调换了顺序：
             原来模组页是「容器 → 空态」，另外三页是「空态 → 容器」⇒ 空槽时那 8dp 内边距
             一会落在字上面、一会落在字下面（用户：「底下也还不一样啊」）。
             现在四页统一：筛选提示 → 空态 → 列表容器 → 底部留白。 -->
        <TextView
            android:id="@+id/mod_empty"
            style="@style/PageEmpty" />

        <!-- 模组列表容器（条目由 ModsActivity.rebuildList() 全展开挂载）
             第 163 轮：底部内边距 12dp → **8dp**，与另外三页的 `*_list` 对齐 -->
        <LinearLayout
            android:id="@+id/mod_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="@dimen/page_pad"
            android:paddingEnd="@dimen/page_pad"
            android:paddingBottom="8dp" />

        <!-- F5b：底部留白（滚到底时末项与导航栏留出间隙）。见 activity_main.xml -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/page_bottom_space" />
    </LinearLayout>
</ScrollView>
