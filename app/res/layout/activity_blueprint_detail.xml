<?xml version="1.0" encoding="utf-8"?>
<!--
  蓝图详情页（F22）：从蓝图列表点进来。

  ★ 结构照抄 activity_map_detail：顶部几行文字 + 若干**可折叠**卡片（`card_stat_section`）。
    · 预览图 = **色块档**（第 116 轮）：配色烘在 `BlockTable` 里（生成配方见那个文件头），
      几何口径照抄游戏 `Schematics#getBuffer`（多格方块往外扩 `(size-1)/2`）。
      ⚠️ **像素级**（用真实图集画方块贴图）仍然要自研 `sprites.aatls` 解析（REF §73 判为"大"），
      那是另一件事；本页是"像地图预览那样一眼看出布局"。
    · 🔴 出不了图时**不许留空框**（用户 2026-10-04）⇒ 默认 GONE，后台拿到位图才 VISIBLE。
  🔴 根节点必须有 `@+id/root` + `Util.applySystemInsets(root)`（见 activity_maps.xml 的注释）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <ScrollView
        android:id="@+id/bp_detail_scroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="12dp">

            <!-- 预览大图（色块档）。★ 默认 GONE，见文件头那条"不留空框" -->
            <ImageView
                android:id="@+id/bp_detail_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:adjustViewBounds="true"
                android:scaleType="fitCenter"
                android:visibility="gone"
                android:background="@drawable/card_bg" />

            <TextView
                android:id="@+id/bp_detail_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="12dp"
                android:lineSpacingExtra="3dp"
                android:textSize="13sp"
                android:textColor="@color/fg" />

            <!-- 只有**本槽**的蓝图才给删除入口（模组自带 / APK 里的那份在包里，删不了） -->
            <LinearLayout
                android:id="@+id/bp_detail_actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="10dp"
                android:background="@drawable/card_bg"
                android:visibility="gone">

                <include
                    android:id="@+id/row_bp_detail_delete"
                    layout="@layout/row_action"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:id="@+id/bp_detail_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="14dp"
                android:paddingBottom="4dp"
                android:lineSpacingExtra="2dp"
                android:textSize="13sp"
                android:textColor="@color/fg_muted" />

            <!-- 各段（方块构成 / 缺件 / 技术细节）运行时 inflate card_stat_section 填进来 -->
            <LinearLayout
                android:id="@+id/bp_detail_box"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
