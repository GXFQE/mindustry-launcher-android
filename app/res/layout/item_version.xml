<?xml version="1.0" encoding="utf-8"?>
<!--
  一行「版本」（主界面列表用）。

  ★ 两层结构（外层 padding 提供行距 + 内层卡片）是 F1b 为了绕开
    "RecyclerView + ItemDecoration" 那套；这里不是 RecyclerView，别被 padding 迷惑：
    含义只是"行距由外层 padding 给，卡片本体在里层"。
    横向间距不在这里做 —— 由列表容器的 paddingStart/End 统一给。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="@dimen/card_gap">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/card_bg_press"
        android:paddingStart="14dp"
        android:paddingEnd="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp">

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@drawable/ic_app"
            android:tint="@color/accent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <!--
              ★★ 2026-10-25 用户两轮反馈后的定案（「槽名字太长会遮挡信息」「这样真的好丑（）」
                「要不然我们自己控制断行吧」）：**标题拆成两行，断行由我们自己定**。

              第一行 = 名称 + 类型词（`ver_title`，最多一行，超了省略名字）+ 槽徽标；
              第二行 = 版本号（`ver_ver`，独占整宽，不跟徽标抢）  ← 关键：徽标只影响第一行。
              第三行 = 副标题（来源 · 大小 · 存档份数）。

              ⚠️ 别再合并回一个 TextView：那样子系统会在任意空格处断行，而徽标的宽度
                 是**每一行**都要付的 ⇒ 长槽名把版本号那行挤窄 ⇒ 又变成「版本号被折叠」
                 （F7 在 2026-10-06 就修过这个，2026-10-25 又踩了两次）。
              ⚠️ 也别把徽标塞到按钮上方（用户：「这样真的好丑」）或副标题行（会把来源挤掉）。
            -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/ver_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textSize="15sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/fg" />

                <TextView
                    android:id="@+id/ver_slot_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/badge_slot"
                    android:paddingStart="8dp"
                    android:paddingEnd="8dp"
                    android:paddingTop="2dp"
                    android:paddingBottom="2dp"
                    android:textSize="10sp"
                    android:textColor="@color/chip_fg"
                    android:maxWidth="64dp"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <!-- 版本号：独占一行 ⇒ 长槽名挤不到它（`buildTitleVersion` 填这里） -->
            <TextView
                android:id="@+id/ver_ver"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:ellipsize="end"
                android:paddingTop="1dp"
                android:textSize="13sp"
                android:textColor="@color/fg_muted" />

            <TextView
                android:id="@+id/ver_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="3dp"
                android:maxLines="2"
                android:ellipsize="end"
                android:textSize="12sp"
                android:textColor="@color/fg_muted" />

            <TextView
                android:id="@+id/ver_conflict"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:textSize="11sp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/chip_fg_warn"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/ver_slot_btn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:background="@drawable/btn_ghost"
            android:clickable="true"
            android:focusable="false"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textSize="13sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/accent" />
    </LinearLayout>
</LinearLayout>