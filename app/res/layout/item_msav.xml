<?xml version="1.0" encoding="utf-8"?>
<!--
  存档/地图列表的**一行**：外padding + 卡片背景 = 每条一个"框"。

  ★ 为什么要框（用户 2026-10-03 反馈"区分度依旧很低"）：纯文本列表里，
    一条的"第二行"和**下一条的第一行**贴着，读起来是一整片；加框之后边界来自视觉而不是靠读。
  ★ 左侧 `msav_thumb` 是地图预览缩略图（F10 预览目标）：默认 **GONE** ——
    存档列表、以及还没渲染出来的行都不占位。
  ⚠️ 外边距**不能**直接写在这个根布局上（AbsListView 会忽略 item 根的 layout_margin）——
     所以外面这层是 padding 容器，卡片本身在里层（见 FLOWS F2b 的"ListView item margin"那条坑）。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="10dp"
    android:paddingEnd="10dp"
    android:paddingTop="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@drawable/card_bg_press"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <ImageView
            android:id="@+id/msav_thumb"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="12dp"
            android:layout_gravity="center_vertical"
            android:scaleType="fitCenter"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/msav_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="middle"
                android:textColor="@color/fg"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/msav_sub"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/fg_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!--
          ★ 第 127 轮（批量导出）：勾选模式下的复选框。默认 GONE —— 单选模式（点一行直接干活）
            的列表不该多出一个框。⚠️ `clickable=false` / `focusable=false` 是**必须**的：
            触摸要整个交给 ListView（点行 = 勾选），否则点框本身会"点不动"，
            而且那一行的高亮状态也会错乱。
        -->
        <CheckBox
            android:id="@+id/msav_check"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="6dp"
            android:clickable="false"
            android:focusable="false"
            android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
