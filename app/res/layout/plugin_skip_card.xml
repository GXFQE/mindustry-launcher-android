<?xml version="1.0" encoding="utf-8"?>
<!--
  「上次带插件启动没成功」提示卡（第 180 轮：原来是页面顶部一列不说话的灰字）。

  结构：[⚠] 标题 / 每个插件一行"谁、哪一份、被怎么处置了" / 一条恢复动作。
  ★ 用警告底色（chip_bg_warn）而不是普通卡面：它讲的是**已经发生过的失败**，
    与下面「已安装」的常态列表必须在第一眼就分开。
  ★ 恢复按钮只在"那一版的文件还在"时才出现（判据在 PluginsActivity.skipBanner）——
    按下去什么都不会发生的按钮不给。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/card_gap"
    android:background="@drawable/card_warn_bg"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="14dp"
    android:paddingTop="14dp"
    android:paddingBottom="14dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ic_warning"
            android:tint="@color/chip_fg_warn" />

        <TextView
            android:id="@+id/plugin_skip_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:textSize="14sp"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/chip_fg_warn" />
    </LinearLayout>

    <TextView
        android:id="@+id/plugin_skip_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="6dp"
        android:textSize="13sp"
        android:lineSpacingExtra="3dp"
        android:textColor="@color/fg" />

    <TextView
        android:id="@+id/plugin_skip_restore"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/btn_ghost"
        android:clickable="true"
        android:focusable="false"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium"
        android:textColor="@color/accent" />
</LinearLayout>
