<?xml version="1.0" encoding="utf-8"?>
<!--
  地图页（槽的子页面，REF §56）：**不再用弹窗** —— 弹窗属于发起它的那个页面，
  关掉之后用户会落在"上一级"（用户 2026-10-03 反馈："查看地图后点关闭会返回到上一级页面"）。
  做成独立页面后：返回键/返回箭头就回到槽二级页面。

  ★ 这里是**页面自己的 ListView**（不在 ScrollView 里 ⇒ 没有 F2b 那条"高度塌掉"的问题）。
  ★★ 顶部区 = 表头 + **「导入地图…」/「导出地图…」两行**（用户 2026-10-03 定案：
     "导入和导出都放页面顶上吧"）。动作行放底部会盖住列表末行、手指按在它上面时列表滑不动。

  🔴 根节点必须有 `@+id/root`，且 Activity 必须调 `Util.applySystemInsets(root)`：
     targetSdk ≥ 35 强制 edge-to-edge ⇒ 没有这一步，**整页内容从屏幕 y=0 开始画**，
     被状态栏（0~112px）+ 顶栏（112~305px）整块盖住。真机实测（第 81 轮，`uiautomator dump`）：
     maps_head = [0,0][1224,112]、导入行 = [46,112][1178,316] —— view 在树里、
     有文字，但**一个像素都看不见**，列表顶上还像"被切掉一行"。
     ⚠️ 别改成 `android:fitsSystemWindows="true"`：Util.java 里写过它在 edge-to-edge 下不可靠，
        而且另外 5 个页面走的都是 applySystemInsets（两套写法并存 = 迟早只修一边）。

  ★★ 2026-10-16（第 151b 轮）：**根从 `LinearLayout` 改成 `ScrollView`，列表从 `ListView`
     改成手工挂载的 `LinearLayout`** —— 与主界面 / 存档页（F2c / F3b）同一条口径。
     为什么必须改：原来是「顶部固定 + 列表 `0dp/weight=1`」，而**横屏可用高只有
     1224px(376dp) − ActionBar**；动作卡（5 行 ≈ 400dp）一撑满，`weight` 子视图只能拿 0
     ⇒ 第 5 行、搜索框与整张列表**被挤到屏幕外**，根又不能滚 = 用户报的「横屏根本点不到下面」。
     真机复现：横屏 `uiautomator dump` 到 `row_maps_del` 就没了（`maps_search` / `maps_list`
     一个都不在树里，因为**完全落在屏幕外的节点不上报**）。
     ⚠️ 这张卡里的 5 行**顺序不许动**（动作卡在列表之前 —— 自检 ㉛ 钉着）。
-->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/bg">

  <LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/maps_head"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="6dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp" />

    <LinearLayout
        android:id="@+id/maps_actions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/card_bg"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="8dp">

        <!--
          ★ 2026-10-17（第 155 轮）：**两行合成一行** —— 原来「导入地图…」（从文件）与
            「本槽存档 → 地图…」（从 `saves/` 挑一份）各占一行，而它们是**同一件事的两条路**
            （都是往本槽 `maps/` 里加一张图）⇒ 照主界面「添加游戏」的成例（REF §84）：
            一行 + 弹窗二选一。
          为什么必须合：用户 2026-10-17「有些页面（比如地图）按钮已经够多了，要不整合下？」——
            这张卡 6 行时，横屏 376dp 的可用高连**列表都看不见**（见文件头 151b 的注释）。
          ⚠️ 从存档那条路**不过**系统文件选择器：手机上的存档就在本槽 `saves/` 里，而 SAF
            够不到 `Android/data/…`（用户原话：「我就是不希望手动导入啊，要不然我为什么不用原版」）。
        -->
        <include
            android:id="@+id/row_maps_import"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <include
            android:id="@+id/row_maps_export"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <!--
          ★ 2026-10-11（第 129 轮）：**批量删除**（与蓝图页同一行、同一套实现，见 REF §90.7）。
          ⚠️ 与上面几行的区别：这一行**会动文件** —— 但只挪进中转站，不直接删。
        -->
        <include
            android:id="@+id/row_maps_del"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="62dp"
            android:background="@color/divider" />

        <!--
          ★ 2026-10-07（第 122 轮）：「筛选与排序」（搜索词 + 排序 + 只看有问题的）。
          ★ 为什么放在**这一张卡里**而不是另起一卡：它与上面三行的作用域一样 ——
            都是"这一页的这份列表"；另起一卡会在页顶多出一块没有必要的区域。
          ★ 它是**纯前端**的：只筛内存里已经清点好的那份清单，一个文件都不碰
            （判据在 `Maps.filterAndSort`，与列表行显示的是同一份数据）。
        -->
        <include
            android:id="@+id/row_maps_filter"
            layout="@layout/row_action"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
    </LinearLayout>

    <!--
      搜索框（第 122 轮）：与模组页同一个形状 —— 就在列表正上方。
      ⚠️ 提示语在 Java 里绑（`Trans.bind`）：布局够不到用户语言包。
    -->
    <EditText
        android:id="@+id/maps_search"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/page_pad"
        android:layout_marginEnd="@dimen/page_pad"
        android:layout_marginTop="2dp"
        android:inputType="text"
        android:maxLength="60"
        android:singleLine="true"
        android:textColor="@color/fg"
        android:textColorHint="@color/fg_muted"
        android:textSize="15sp" />

    <!-- 筛选状态（只有真的在筛选时才显示；见 MapsActivity.rebuildList） -->
    <TextView
        android:id="@+id/maps_filtered"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/page_pad"
        android:paddingEnd="@dimen/page_pad"
        android:paddingTop="6dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp"
        android:visibility="gone" />

    <!--
      ★ 空态（2026-10-04 补）。可见性由 MapsActivity 的清点结果控制。
      ⚠️ 为什么必须有：这句 `maps_empty_fmt` 早就写好了，但**全工程零引用**（孤儿串）——
         一张图都没有时，用户只看到表头「本槽 0 · 游戏自带 0 · 模组自带 0」+ 一整片空白，
         既不知道"为什么没有"，也不知道"下一步该干什么"。而"槽还没指到版本"时必然出现。
      🔴 位置必须在列表容器 **之前**（列表现在是 `wrap_content` 的手工容器，见文件尾）：
         空态若排在它后面，就会被顶到整页最底部（其它页面的空态都紧跟卡片）。
      ⚠️ 样式与别的页面空态一致（见 activity_main.xml 的 ver_empty）。
    -->
    <TextView
        android:id="@+id/maps_empty"
        style="@style/PageEmpty"
        android:visibility="gone" />

    <!--
      ★★ 列表容器：**不是 `ListView`**（2026-10-16 第 151b 轮，F3b 口径）。
        · 放在整页 `ScrollView` 里的 `ListView` 只按**单行**估高 ⇒ 滚不到底（F3b 的根因，AOSP 公式级）；
        · 而"顶部固定 + 列表自滚"那个老结构在横屏根本分不到高度（见文件头）。
        ⇒ 行由 `MsavListAdapter.fillInto()` 手工挂载，滚动交给外层 `ScrollView`。
      ⚠️ 它必须排在搜索框 / 空态**之后**（那两句是"列表的说明"，跑到列表下面就读不通了）。
    -->
    <LinearLayout
        android:id="@+id/maps_list"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="8dp" />

    <!-- 第 163 轮：底部留白 —— 与另外三页同一份（原来只有模组页有） -->
    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/page_bottom_space" />
  </LinearLayout>
</ScrollView>
