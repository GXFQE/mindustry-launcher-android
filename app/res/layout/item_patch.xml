<?xml version="1.0" encoding="utf-8"?>
<!--
  补丁页的一行（第 345 轮）：名字 + 版本 / 「N 个类 · 状态」。

  ★ 行本身可点（进详情卡：启用 / 停用 / 删除 / 看类清单）。
    状态不放在开关控件上：开关的"开"会让人以为是全局开关，而补丁的启停是**按版本**的；
    一行文字说清"这个版本上它是启用还是没启用"，点进去才改 —— 与版本页其它动作同一个模式。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/patch_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/card_bg"
    android:clickable="true"
    android:focusable="false"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="13dp"
    android:paddingBottom="13dp">

    <TextView
        android:id="@+id/patch_item_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="2"
        android:textColor="@color/fg"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/patch_item_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="3dp"
        android:textColor="@color/fg_muted"
        android:textSize="12sp" />
</LinearLayout>
