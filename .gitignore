# ─── 构建产物（build.sh 产出，可重生成）──────────────────────────────────
# build/ = aapt2/javac/d8 中间物 + 对齐签名后的 APK
# .build-trash/ = 撞「单轮批量删除闸」时的归档目录（只归档不删，会一直涨）
build/
.build-trash/
*.apk
*.idsig

# ─── 临时工作区（脚本/人工的暂存，随时可清）──────────────────────────────
# .tmp/ .tmp-ui/ 是脚本用的；.tmp-* 是手工排查时留下的一次性文件/目录
#   （.tmp-cleanup/ .tmp-restore/ .tmp-flows-*.md .tmp-ref*.md …）
/.tmp/
/.tmp-ui/
/.tmp*

# ─── 实验快照（spike 过程备份，非源码本体）───────────────────────────────
.spike-backup/

# ─── 设备侧报告拉回的副本 ───────────────────────────────────────────────
# 真件在设备的 <外部 hub>/report-*.txt（report-m3.txt / report-devtool.txt）。
# 仓库里这份只是 adb pull 回来的工作副本，随取随新，不入库。
report-*.txt

# ─── 真机取证截图（不随仓库发布，策略见 docs/DEVELOPING.md）───────────────
# evidence/*.png = 真机截图，曾占仓库 95% 的体积（211 张 / 约 60 MB）。
# 2026-10-04 起移出仓库、只留本地归档；文档里仍按文件名引用（作来源标注，不是可点的文件）。
# ⚠️ 要临时把某张图放回仓库：`git add -f evidence/xxx.png`。
evidence/*.png

# ─── 开发笔记目录（含本机路径 / 交接笔记，不进公开仓库）──────────────────
# 2026-10-02 换过目录名 —— 新名与旧名两条规则都留着，防旧路径哪天又被写回来。
.dsh/
.workbuddy/

# ─── 项目指令文件（编辑器 / 助手每轮自动加载；同样属于本机私有）────────────────────
# AGENTS.md 是作者的个人上下文（含本机路径与设备信息）⇒ 不进仓库。
# ⚠️ 它不是"团队约定文件"：这份是**个人上下文**，换机器要重写。
#    （通用 AGENTS.md 是可以提交的；这条忽略只针对本工程这份 personally-owned 的。）
AGENTS.md

# ─── 签名材料（防误放）──────────────────────────────────────────────────
# build.sh 默认用 $HOME/.android/debug.keystore（在仓库外）；
# 这两条只是防止哪天把 keystore 拷进工程里被一起提交。
*.keystore
*.jks

# ─── 通用 ────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.log
.idea/
.vscode/

# 保留：app/（源码 + 资源 + AndroidManifest）、build.sh、README.md /
#       FLOWS.md / BACKLOG.md（三份文档）、spike/（实验记录）、
#       evidence/（真机取证，README 引用 25 处）、
#       tools/（i18n 构建期门禁：i18n-check.py + i18n-known.txt）

# ── 改源码时留的工序备份（*.bak / *.bak2 / *.emptied.bak …）——不提交 ────────
*.bak*
